# Local Vite dev and preview proxy to FastAPI on port 8000.
VITE_API_BASE_URL=/api/v1
# Supabase browser values are publishable and may be included in the client build.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-project-publishable-key
# For hosted deployment, use the HTTPS FastAPI URL before building.
