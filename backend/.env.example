NETSIGHT_DATABASE_PATH=data/netsight.db
NETSIGHT_SUPABASE_URL=http://127.0.0.1:54321
NETSIGHT_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-project-publishable-key
NETSIGHT_WEBRISK_API_KEY=
# Use sqlite for the laptop demo; set supabase for production Postgres with RLS.
NETSIGHT_STORAGE_BACKEND=sqlite
NETSIGHT_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
